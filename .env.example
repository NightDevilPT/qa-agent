# ==============================================================================
# AUTONOMOUS QA AGENT ENVIRONMENT CONFIGURATION
# ==============================================================================

# Active LLM Provider picked from .env: 'docker', 'gemini', or 'openai'
LLM_PROVIDER=docker

# ------------------------------------------------------------------------------
# 1. DOCKER LLM PROVIDER CONFIGURATION (Local OpenAI-Compatible Server)
# ------------------------------------------------------------------------------
# API Base URL of your local Docker container (Ollama, vLLM, LocalAI, LiteLLM)
DOCKER_LLM_BASE_URL=http://localhost:12434/v1

# Name of the model running in your Docker container
DOCKER_LLM_MODEL=ai/qwen2.5

# Dummy API Key required for local OpenAI client compatibility
DOCKER_LLM_API_KEY=docker

# ------------------------------------------------------------------------------
# 2. GEMINI LLM PROVIDER CONFIGURATION (Google Gemini Cloud Model)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# ------------------------------------------------------------------------------
# 3. OPENAI CLOUD LLM PROVIDER CONFIGURATION (OpenAI Cloud Model)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 4. SYSTEM & QA AGENT GUARDRAIL CONFIGURATION
# ------------------------------------------------------------------------------
# Maximum token budget cap across an entire agent run
MAX_TOKEN_BUDGET=50000

# Docker test execution timeout per test file (in seconds)
PER_TEST_TIMEOUT_SEC=30
